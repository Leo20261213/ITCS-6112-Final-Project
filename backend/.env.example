# Copy to backend/.env and adjust. Values in the real environment take precedence.

# PostgreSQL from `docker compose up -d db` (user/db "helpdesk", password POSTGRES_PASSWORD).
DATABASE_URL=postgresql://helpdesk:helpdesk@localhost:5433/helpdesk

# Claude for the AI features (US-15..US-19). Without it, the built-in rules are used.
# ANTHROPIC_API_KEY=sk-ant-...

# Keep users signed in across restarts.
# SECRET_KEY=change-me
