# Local SQLite development (default)
# DATABASE_URL=sqlite:///./helpdesk.db

# MySQL example for team integration
# DATABASE_URL=mysql+pymysql://helpdesk_user:change_me@localhost:3306/helpdesk_db?charset=utf8mb4

# Replace with a long random value and keep this file out of Git if copied to .env
SECRET_KEY=replace-with-a-long-random-secret

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SEED_DEMO_DATA=1

UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10

# AI provider configuration. The API key is never stored in the database.
AI_ENABLED=false
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=
